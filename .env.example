# Code Sapiens — The Challenge Arena: environment variables
# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored — never commit real keys.

# --- Supabase (Project Settings → API) — used from Phase 3 onward ---
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy "anon" public key.
# Safe for the browser: row-level security protects the data, not this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App ---
# Public base URL, used for auth redirects and QR profile links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: The app does NOT need the Supabase service_role / secret key.
# Do not add it here, and never expose it with a NEXT_PUBLIC_ prefix.

# Live Quiz: enable Supabase Anonymous Sign-Ins and apply all migrations.
# Only quiz_signal should be enabled for the quiz Realtime publication.
# See docs/live-quiz.md for first-admin provisioning and event setup.
